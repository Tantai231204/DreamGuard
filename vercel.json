{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cohabit.vn/api/:path*"
    },
    {
      "source": "/chathub/:path*",
      "destination": "https://cohabit.vn/chathub/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}